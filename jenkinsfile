
pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'jermy001/attendance-checker'
        DOCKER_TAG = 'latest'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Check Python') {
            steps {
                bat 'python --version'
            }
        }

        stage('Run Attendance Program') {
            steps {
                bat 'python student_attendance.py'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %DOCKER_IMAGE%:%DOCKER_TAG% .'
            }
        }

        stage('Verify Docker Image') {
            steps {
                bat 'docker image inspect %DOCKER_IMAGE%:%DOCKER_TAG%'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Attendance Checker pipeline completed!'
        }
        failure {
            echo 'FAILURE: Check the Jenkins console output.'
        }
    }
}
